<SQL><![CDATA[SELECT /* CDS access control applied */ /* Contains Native SQL */ "AIRPORT_FROM_ID" "AIRPORT_FROM_ID" , "AIRPORT_TO_ID" "AIRPORT_TO_ID" , "BOOKING_DATE" "BOOKING_DATE" , "BOOKING_PER_CLASS" "BOOKING_PER_CLASS" , "CARRIER_ID" "CARRIER_ID" , "CARRIER_NAME" "CARRIER_NAME" , "CONNECTION_ID" "CONNECTION_ID" , "CURRENCY_CODE" "CURRENCY_CODE" , "FLIGHT_DATE" "FLIGHT_DATE" , "PRICE_CLASS" "PRICE_CLASS" , "UNIQUE_ID" "UNIQUE_ID" FROM "ZTM268_C_BOOKING_CONN_CARR_900" "ZTM268_C_BOOKING_CONN_0" WHERE "MANDT" = ? AND "CARRIER_NAME" = ? ORDER BY "ZTM268_C_BOOKING_CONN_0" . "CARRIER_ID" , "ZTM268_C_BOOKING_CONN_0" . "CARRIER_NAME" , "ZTM268_C_BOOKING_CONN_0" . "CURRENCY_CODE" , "ZTM268_C_BOOKING_CONN_0" . "CONNECTION_ID" , "ZTM268_C_BOOKING_CONN_0" . "FLIGHT_DATE" , "ZTM268_C_BOOKING_CONN_0" . "UNIQUE_ID" , "ZTM268_C_BOOKING_CONN_0" . "PRICE_CLASS" , "ZTM268_C_BOOKING_CONN_0" . "BOOKING_DATE" LIMIT 200 WITH PARAMETERS( 'LOCALE' = 'EN' )  WITH HINT(NO_USE_HEX_PLAN,NO_SEMI_JOIN_BEFORE_UNION )]]></SQL>
